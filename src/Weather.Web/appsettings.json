{
  "Weather": {
    "Location": "Moscow",
    "ForecastDays": 3,
    "TimeZoneId": "Europe/Moscow",
    "Cache": {
      "LocalCacheExpiration": "00:05:00",
      "Expiration": "00:10:00",
      "StaleExpiration": "01:00:00"
    },
    "Performance": {
      "SlowQueryThreshold": "00:00:00.500"
    },
    "BackgroundRefresh": {
      "Enabled": false,
      "Interval": "00:05:00"
    }
  },
  "WeatherApi": {
    "BaseUrl": "https://api.weatherapi.com",
    "RequestTimeout": "00:00:05",
    "UseSeparateCurrentEndpoint": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
