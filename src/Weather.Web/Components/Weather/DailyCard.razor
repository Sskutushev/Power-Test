<article class="card daily-card">
    <div class="daily-card__day">
        <strong>@WeatherFormat.RelativeDayLabel(Item.Date, Today)</strong>
        <time class="muted" datetime="@WeatherFormat.Iso(Item.Date)">@WeatherFormat.DayLabel(Item.Date)</time>
    </div>
    <div class="daily-card__condition">
        <WeatherIcon IconUrl="@Item.Condition.IconUrl"
                     Alt="@Item.Condition.Text"
                     Decorative="true"
                     Size="WeatherIcon.WeatherIconSize.Small" />
        <span>@Item.Condition.Text</span>
    </div>
    <span class="daily-card__rain" title="Вероятность осадков">@WeatherFormat.Percent(Item.ChanceOfRain)</span>
    <div class="daily-card__range">
        <span class="daily-card__max">@WeatherFormat.TemperatureShort(Item.MaxC)</span>
        <span class="daily-card__min muted">@WeatherFormat.TemperatureShort(Item.MinC)</span>
    </div>
</article>

@code {
    /// <summary>Daily entry.</summary>
    [Parameter]
    public required DailyForecastDto Item { get; set; }

    /// <summary>Provider-local today, used to render "Сегодня"/"Завтра".</summary>
    [Parameter]
    public DateOnly Today { get; set; }
}
