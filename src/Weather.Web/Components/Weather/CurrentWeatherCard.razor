<section class="card current-weather" aria-label="Текущая погода">
    <div class="current-weather__readout">
        <p class="condition">@Current.Condition.Text</p>
        <p class="temperature">@WeatherFormat.Temperature(Current.TempC)</p>
        <p class="muted">Ощущается как @WeatherFormat.Temperature(Current.FeelsLikeC)</p>
    </div>
    <WeatherIcon IconUrl="@Current.Condition.IconUrl"
                 Alt="@Current.Condition.Text"
                 Decorative="true"
                 Size="WeatherIcon.WeatherIconSize.Large" />
</section>

@code {
    /// <summary>Current conditions.</summary>
    [Parameter]
    public required CurrentWeatherDto Current { get; set; }
}
