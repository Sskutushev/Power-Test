@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<IntroCurtain> Logger

@* Shown once per session on a cold start. It doubles as the loading state, so the wait for the provider
   is spent on something worth looking at instead of on a spinner — and it never blocks: Escape, the skip
   button, and reduced-motion all dismiss it immediately. *@
@if (phase is not Phase.Gone)
{
    <div class="curtain @(phase == Phase.Leaving ? "curtain--leaving" : null)"
         role="dialog"
         aria-modal="false"
         aria-label="Заставка приложения"
         tabindex="-1"
         @ref="root"
         @onkeydown="HandleKeyDownAsync">
        <div class="curtain__content">
            <p class="curtain__eyebrow">
                <span class="curtain__pulse" aria-hidden="true"></span>
                Москва · 55.75, 37.62
            </p>

            <h1 class="curtain__title">
                <span class="curtain__word" style="--i: 0">Небо</span>
                <span class="curtain__word" style="--i: 1">над</span>
                <span class="curtain__word curtain__word--accent" style="--i: 2">Москвой</span>
            </h1>

            <p class="curtain__lead">
                Текущая погода, оставшиеся часы сегодня, весь завтрашний день
                и три дня вперёд — на одном экране.
            </p>

            <div class="curtain__progress" role="progressbar" aria-label="Загрузка прогноза" aria-valuetext="@Caption">
                <span class="curtain__progress-bar" data-complete="@IsReady.ToString().ToLowerInvariant()"></span>
            </div>
            <p class="curtain__caption">@Caption</p>

            @* One decision, once. Burying the location choice in a corner chip means nobody finds it, and
               prompting for geolocation unasked is the fastest way to get permanently denied. *@
            <div class="curtain__choice">
                <button type="button"
                        class="button button--primary"
                        disabled="@isLocating"
                        @onclick="UseMyLocationAsync">
                    @(isLocating ? "Определяем…" : "Показать мою погоду")
                </button>
                <button type="button" class="button button--ghost curtain__skip" @onclick="SkipAsync">
                    Остаться в Москве
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const int MinimumVisibleMs = 1400;
    private const int LeaveDurationMs = 900;
    private const int MaximumWaitMs = 15000;

    /// <summary>How long the location choice stays on screen after the data has arrived.</summary>
    private const int AutoDismissAfterReadyMs = 3200;

    private static readonly string[] Captions =
    [
        "Соединяемся с провайдером погоды",
        "Читаем прогноз на три дня",
        "Собираем почасовую сетку"
    ];

    private readonly CancellationTokenSource cts = new();
    private TaskCompletionSource readySignal = new(TaskCreationOptions.RunContinuationsAsynchronously);
    private IJSObjectReference? module;
    private IJSObjectReference? geolocation;
    private ElementReference root;
    private Phase phase = Phase.Entering;
    private int captionIndex;
    private bool isLocating;

    /// <summary>Set by the page once the first load has settled, successfully or not.</summary>
    [Parameter]
    public bool IsReady { get; set; }

    /// <summary>Raised with the visitor's coordinates when they choose to use their own location.</summary>
    [Parameter]
    public EventCallback<LocationSwitcher.GeoCoordinates?> OnLocationChosen { get; set; }

    private string Caption => IsReady ? "Готово" : Captions[captionIndex % Captions.Length];

    protected override void OnParametersSet()
    {
        if (IsReady)
        {
            readySignal.TrySetResult();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/intro.js");

            if (module is null || !await module.InvokeAsync<bool>("shouldShow"))
            {
                phase = Phase.Gone;
                StateHasChanged();
                return;
            }

            await root.FocusAsync();
            await RunAsync();
        }
        catch (JSDisconnectedException)
        {
            phase = Phase.Gone;
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, "intro_curtain_unavailable");
            phase = Phase.Gone;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Asks the browser for a position only after the visitor pressed the button, then hands it to the
    /// page and closes. A denial simply keeps the configured location.
    /// </summary>
    private async Task UseMyLocationAsync()
    {
        if (isLocating)
        {
            return;
        }

        isLocating = true;

        try
        {
            geolocation ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/geolocation.js");

            if (geolocation is not null)
            {
                LocationSwitcher.GeoCoordinates? coordinates =
                    await geolocation.InvokeAsync<LocationSwitcher.GeoCoordinates?>("request");

                if (coordinates is not null)
                {
                    await OnLocationChosen.InvokeAsync(coordinates);
                }
            }
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            Logger.LogDebug(exception, "intro_geolocation_failed");
        }
        finally
        {
            isLocating = false;
        }

        await DismissAsync();
    }

    private async Task RunAsync()
    {
        // Caption rotation is deliberately not awaited: it ends on its own when the data settles.
        _ = RotateCaptionsAsync();

        try
        {
            Task minimum = Task.Delay(MinimumVisibleMs, cts.Token);
            Task ready = readySignal.Task.WaitAsync(TimeSpan.FromMilliseconds(MaximumWaitMs), cts.Token);

            await Task.WhenAll(minimum, ready);

            // Once the data is in, the curtain waits a moment for a location decision rather than
            // vanishing under the cursor. It closes on its own if none is made.
            await Task.Delay(AutoDismissAfterReadyMs, cts.Token);
        }
        catch (OperationCanceledException)
        {
            // The user navigated away mid-intro.
            return;
        }
        catch (TimeoutException)
        {
            // The provider is unusually slow; the dashboard's own error state takes over from here.
        }

        await DismissAsync();
    }

    private async Task RotateCaptionsAsync()
    {
        try
        {
            while (!IsReady && !cts.IsCancellationRequested)
            {
                await Task.Delay(900, cts.Token);
                captionIndex++;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Nothing to roll back: the curtain is going away anyway.
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await SkipAsync();
        }
    }

    private Task SkipAsync()
    {
        return phase == Phase.Gone ? Task.CompletedTask : DismissAsync();
    }

    private async Task DismissAsync()
    {
        if (phase == Phase.Gone)
        {
            return;
        }

        phase = Phase.Leaving;
        StateHasChanged();

        try
        {
            await Task.Delay(LeaveDurationMs, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        phase = Phase.Gone;
        StateHasChanged();

        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("markSeen");
            }
            catch (Exception exception) when (exception is JSDisconnectedException or JSException)
            {
                // Not being able to remember the intro is harmless.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        await cts.CancelAsync();
        cts.Dispose();

        foreach (IJSObjectReference? reference in new[] { module, geolocation })
        {
            if (reference is null)
            {
                continue;
            }

            try
            {
                await reference.DisposeAsync();
            }
            catch (Exception exception) when (exception is JSDisconnectedException or JSException or ObjectDisposedException)
            {
                // Circuit already gone.
            }
        }
    }

    private enum Phase
    {
        Entering,
        Leaving,
        Gone
    }
}
